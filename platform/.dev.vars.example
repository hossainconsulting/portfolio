# Copy to .dev.vars for `npm run dev`. Never commit .dev.vars.
# All four are optional locally: without them the platform logs magic links
# instead of emailing, shows "not configured" on /buy, and returns 503 from
# the agent API. Tests need none of them.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
ANTHROPIC_API_KEY=sk-ant-...
RESEND_API_KEY=re_...
