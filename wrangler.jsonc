{
  // Static-asset Worker. `npx wrangler deploy` uploads everything in ./public
  // and serves it directly - no build step, no framework, no server code.
  "name": "portfolio",
  "compatibility_date": "2026-01-01",

  // Serve only on portfolio.hossainconsulting.com. Without these, Wrangler
  // defaults both to true and the site is also published at
  // portfolio.hossainconsulting.workers.dev - a second public URL serving
  // identical content, which search engines read as duplicate content.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  }
}
